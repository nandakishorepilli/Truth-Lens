# Placeholders only. Copy to backend/.env and fill in what you are authorized to use.
# Model IDs are intentionally empty: set the ones your account can actually access.

# ── Google Gemini ────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Example models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=

# ── Groq ─────────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=
# Example models: llama-3.1-8b-instant, llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Model format: provider/model-name  e.g. openai/gpt-4o-mini, anthropic/claude-3-5-sonnet
OPENROUTER_MODEL=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# (Milestone 3B — adapter not yet implemented)
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Anthropic ────────────────────────────────────────────────────────────────
# (Milestone 3B — adapter not yet implemented)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── xAI ──────────────────────────────────────────────────────────────────────
# (Milestone 3B — adapter not yet implemented)
XAI_API_KEY=
XAI_MODEL=

# ── Ollama (local, keyless) ───────────────────────────────────────────────────
# Install Ollama: https://ollama.ai
# Pull a model first: ollama pull llama3.1
# OLLAMA_BASE_URL defaults to http://localhost:11434 if not set.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ── API server ───────────────────────────────────────────────────────────────
# Explicit origins only; "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database path (relative to the backend/ directory)
DATABASE_URL=sqlite:///./truthlens.db
